*/

&flash0 {
        partitions {
                factory_partition: partition@1e3000 {
                        reg = <0x001e3000 DT_SIZE_K(4)>;
                };

                settings_partition: partition@1e4000 {
                        reg = <0x001e4000 DT_SIZE_K(4)>;
                };
        };
};

&code_partition {
       reg = <0x0000000 DT_SIZE_K(1932)>;
};


&storage_partition {
        reg = <0x001e5000 DT_SIZE_K(100)>;
};
