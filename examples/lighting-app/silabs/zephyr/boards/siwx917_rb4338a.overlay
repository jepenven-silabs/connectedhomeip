/ {
	chosen {
		zephyr,entropy = &rng0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &flashctrl0;
		zephyr,shell-uart = &ulpuart;
		zephyr,console = &ulpuart;
		zephyr,code-partition = &code_partition;
	};
};

&ulpuart {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&ulpuart_default>;
	pinctrl-names = "default";
};



&sram0 {
    status = "okay";
    reg = <0x00000400 DT_SIZE_K(319)>;
};


/*
&flash0 {
    status = "okay";
    partitions {
        code_partition: partition@0 {
			reg = <0x0000000 DT_SIZE_K(2000)>;
			label = "code_partition";
		};

        factory_partition: partition@1f4000 {
            label = "factory-data";
            reg = <0x001f400 DT_SIZE_K(4)>;
        };

        settings_partition: partition@1f500 {
            label = "settings_partition";
            reg = <0x001f5000 DT_SIZE_K(4)>;
        };

        storage_partition: partition@1f6000 {
			reg = <0x001f6000 DT_SIZE_K(32)>;
			label = "storage";
		};
    };
